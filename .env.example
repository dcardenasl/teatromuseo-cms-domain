#--------------------------------------------------------------------
# Example Environment Configuration File — Website Builder
#
# Copy this file to .env and customize. NEVER commit .env to git.
#
# Command: cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8190'
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = ci4_website_builder_domain
database.default.username = root
database.default.password = YOUR_DATABASE_PASSWORD_HERE
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# Test database
database.tests.hostname = 127.0.0.1
database.tests.database = ci4_website_builder_domain_test
database.tests.username = root
database.tests.password = YOUR_DATABASE_PASSWORD_HERE
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = ""
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Generate with: php spark key:generate
encryption.key = ""

#--------------------------------------------------------------------
# HUB COORDINATES — REQUIRED
#
# This website builder app delegates auth to a central ci4-api-starter ("hub"). The
# hub validates JWTs (via /auth/introspect) and issues service tokens (via
# /auth/service-token) that this app uses for M2M calls back to the hub.
#
# All three are required: hub.url, hub.appCode, and hub.apiKey
#--------------------------------------------------------------------

# Base URL of the hub (no trailing slash). REQUIRED.
hub.url = 'http://localhost:8180'

# Public HTTPS origin for browser-facing uploads. Optional locally; required
# when hub.url is an internal/private hostname. Example:
# HUB_PUBLIC_URL = 'https://api.example.com'

# Application code as registered in the hub (one row in the `applications` table).
# Used as the JWT `sub` for service tokens issued to this app. REQUIRED.
hub.appCode = 'example-website-builder'

# X-App-Key header value. Created by `php spark apps:bootstrap <code>` on the
# hub side; the key is bound to a single application_id. REQUIRED.
# Example: hub.apiKey = apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
hub.apiKey = ''

# Public-read Hub media policy: one attempt, short connect/deadline, and a
# bounded stale cache when the Hub is unavailable.
PUBLIC_READ_HUB_CONNECT_TIMEOUT = 0.25
PUBLIC_READ_HUB_TIMEOUT = 1.0
PUBLIC_READ_HUB_STALE_TTL = 900

# Cache TTL (seconds) for /auth/introspect responses. Lower = revocations
# propagate faster, higher = less load on the hub. Set to 300 in production
# to reduce shared hosting API load. (optional, default: 60)
hub.introspectCacheTtl = 300

# Shared HMAC secret for internal machine-to-machine endpoints (Hub ↔ Domain)
HUB_INTERNAL_SECRET = secret_hmac_key_for_hub_internal_signature

# Secret key required in X-App-Key header for public web server-side requests (/public/*)
WEB_API_KEY = secret_web_app_key_for_cms_public_endpoints

# Optional: Superadmin JWT for setup-only operations like domain:sync-permissions
# Obtain via POST /api/v1/auth/login as superadmin on the hub, then pass --admin-token=<jwt> or set hub.adminToken here.
hub.adminToken = ''

# Optional: Path prefix for event listing integration
cms.eventListingPath = '/events'

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------

CORS_ALLOWED_ORIGINS = 'http://localhost:3000,http://localhost:5173'
CORS_SUPPORTS_CREDENTIALS = false

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------

RATE_LIMIT_REQUESTS = 60
RATE_LIMIT_WINDOW = 60
RATE_LIMIT_USER_REQUESTS = 100
PUBLIC_READ_RATE_LIMIT_REQUESTS = 600
PUBLIC_READ_RATE_LIMIT_WINDOW = 60

#--------------------------------------------------------------------
# QUEUE (used by audit async writes and cache invalidations)
#--------------------------------------------------------------------
# Options: 'database', 'redis', 'sync'.
# IMPORTANT: On shared hosting without a persistent queue:work daemon,
# set these to 'sync' so jobs run immediately during the request.
QUEUE_DRIVER = database
AUDIT_QUEUE_DRIVER = database
CACHE_QUEUE_DRIVER = database
QUEUE_MAX_ATTEMPTS = 3
QUEUE_RETRY_AFTER = 90

# Redis configuration (when QUEUE_DRIVER = redis)
QUEUE_REDIS_HOST = 127.0.0.1
QUEUE_REDIS_PORT = 6379
QUEUE_REDIS_PASSWORD =
QUEUE_REDIS_DATABASE = 0

#--------------------------------------------------------------------
# AUDIT
#--------------------------------------------------------------------
# Set to false on shared hosting to disable async audit enqueuing,
# persisting them synchronously to prevent table bloat without workers.
AUDIT_ASYNC_ENABLED = true

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------

LOG_LEVEL = debug
LOG_FORMAT = json

#--------------------------------------------------------------------
# MAINTENANCE
#--------------------------------------------------------------------

MAINTENANCE_MODE = false
MAINTENANCE_RETRY_AFTER = 60

#--------------------------------------------------------------------
# WEB CACHE INVALIDATION
#--------------------------------------------------------------------
# Base URL of the public website (ci4-website-builder-web) whose response
# cache is purged when CMS content changes, and the shared secret sent in
# the X-Invalidate-Key header. WEB_CACHE_INVALIDATE_KEY must match the
# CACHE_INVALIDATE_KEY configured in the web project's .env.
# CMS writes are recorded in a transactional outbox. Run
# `php spark cache:dispatch-outbox` from cron (or a queue worker wrapper) to
# deliver committed events. Leave both empty only when Web is intentionally
# not deployed; pending events will remain retryable.

WEB_CACHE_INVALIDATE_URL =
WEB_CACHE_INVALIDATE_KEY =
WEB_CACHE_INVALIDATE_TIMEOUT = 5

#--------------------------------------------------------------------
# CMS PREVIEW LINKS
#--------------------------------------------------------------------
# Shared secret used to verify signed ?preview=1 links generated by the admin
# panel (ci4-website-builder-admin). Must match CMS_PREVIEW_SECRET there.
# Without it, preview links never bypass the published/workflow_status gate —
# fails closed, so leaving this unset is safe (just disables preview).

CMS_PREVIEW_SECRET =
