#--------------------------------------------------------------------
# Example Environment Configuration File — Website Builder
#
# Copy this file to .env and customize. NEVER commit .env to git.
#
# Command: cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8090'
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = ci4_website_builder_domain
database.default.username = root
database.default.password = YOUR_DATABASE_PASSWORD_HERE
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# Test database
database.tests.hostname = 127.0.0.1
database.tests.database = ci4_website_builder_domain_test
database.tests.username = root
database.tests.password = YOUR_DATABASE_PASSWORD_HERE
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = ""
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Generate with: php spark key:generate
encryption.key = ""

#--------------------------------------------------------------------
# HUB COORDINATES — REQUIRED
#
# This website builder app delegates auth to a central ci4-api-starter ("hub"). The
# hub validates JWTs (via /auth/introspect) and issues service tokens (via
# /auth/service-token) that this app uses for M2M calls back to the hub.
#
# All three are required: hub.url, hub.appCode, and hub.apiKey
#--------------------------------------------------------------------

# Base URL of the hub (no trailing slash). REQUIRED.
hub.url = 'http://localhost:8080'

# Application code as registered in the hub (one row in the `applications` table).
# Used as the JWT `sub` for service tokens issued to this app. REQUIRED.
hub.appCode = 'example-website-builder'

# X-App-Key header value. Created by `php spark apps:bootstrap <code>` on the
# hub side; the key is bound to a single application_id. REQUIRED.
# Example: hub.apiKey = apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
hub.apiKey = ''

# Cache TTL (seconds) for /auth/introspect responses. Lower = revocations
# propagate faster, higher = less load on the hub. (optional, default: 60)
hub.introspectCacheTtl = 30

# Optional: Superadmin JWT for setup-only operations like domain:sync-permissions
# when using --mirror-to-self. Obtain via POST /api/v1/auth/login as superadmin
# on the hub, then pass --admin-token=<jwt> or set hub.adminToken here.
# hub.adminToken = ''

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------

CORS_ALLOWED_ORIGINS = 'http://localhost:3000,http://localhost:5173'
CORS_SUPPORTS_CREDENTIALS = false

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------

RATE_LIMIT_REQUESTS = 60
RATE_LIMIT_WINDOW = 60
RATE_LIMIT_USER_REQUESTS = 100

#--------------------------------------------------------------------
# QUEUE (used by audit async writes)
#--------------------------------------------------------------------

QUEUE_DRIVER = database
AUDIT_QUEUE_DRIVER = database
CACHE_QUEUE_DRIVER = database
QUEUE_MAX_ATTEMPTS = 3
QUEUE_RETRY_AFTER = 90

#--------------------------------------------------------------------
# AUDIT
#--------------------------------------------------------------------

AUDIT_ASYNC_ENABLED = true

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------

LOG_LEVEL = debug
LOG_FORMAT = json

#--------------------------------------------------------------------
# MAINTENANCE
#--------------------------------------------------------------------

MAINTENANCE_MODE = false
MAINTENANCE_RETRY_AFTER = 60

#--------------------------------------------------------------------
# WEB CACHE INVALIDATION
#--------------------------------------------------------------------
# Base URL of the public website (ci4-website-builder-web) whose response
# cache is purged when CMS content changes, and the shared secret sent in
# the X-Invalidate-Key header. WEB_CACHE_INVALIDATE_KEY must match the
# CACHE_INVALIDATE_KEY configured in the web project's .env.
# Leave both empty to disable remote cache invalidation.

WEB_CACHE_INVALIDATE_URL =
WEB_CACHE_INVALIDATE_KEY =

#--------------------------------------------------------------------
# CMS PREVIEW LINKS
#--------------------------------------------------------------------
# Shared secret used to verify signed ?preview=1 links generated by the admin
# panel (ci4-website-builder-admin). Must match CMS_PREVIEW_SECRET there.
# Without it, preview links never bypass the published/workflow_status gate —
# fails closed, so leaving this unset is safe (just disables preview).

CMS_PREVIEW_SECRET =
