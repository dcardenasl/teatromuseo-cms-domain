{
    "name": "ci4/website-builder",
    "description": "CodeIgniter 4 Website Builder starter — delegates auth to a hub via /auth/introspect.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "dcardenasl/ci4-api-core": "^1.5",
        "ezyang/htmlpurifier": "^4.17",
        "guzzlehttp/psr7": "^2.12.1",
        "monolog/monolog": "^3.5",
        "sentry/sentry": "^4.6",
        "zircote/swagger-php": "^6.0"
    },
    "require-dev": {
        "dcardenasl/ci4-api-scaffolding": "^1.0",
        "fakerphp/faker": "^1.9",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mikey179/vfsstream": "^1.6",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1.56",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "chmod +x pre-commit",
            "cp pre-commit .git/hooks/pre-commit",
            "chmod +x pre-push",
            "cp pre-push .git/hooks/pre-push"
        ],
        "post-update-cmd": [
            "chmod +x pre-commit",
            "cp pre-commit .git/hooks/pre-commit",
            "chmod +x pre-push",
            "cp pre-push .git/hooks/pre-push"
        ],
        "test:prepare-db": "php spark tests:prepare-db",
        "test:unit": [
            "@test:prepare-db",
            "phpunit --testsuite=Unit --configuration=phpunit.xml --no-coverage --testdox"
        ],
        "test:integration": [
            "@test:prepare-db",
            "phpunit --testsuite=Integration --configuration=phpunit.xml --no-coverage --testdox"
        ],
        "test:feature": [
            "@test:prepare-db",
            "phpunit --testsuite=Feature --configuration=phpunit.xml --no-coverage --testdox"
        ],
        "test:dynamic": [
            "@test:prepare-db",
            "phpunit --testsuite=Unit,Architecture,Integration,Feature --configuration=phpunit.xml --no-coverage --testdox"
        ],
        "test:seed-contracts": [
            "@test:prepare-db",
            "phpunit --testsuite=SeederContracts --configuration=phpunit.xml --no-coverage --testdox"
        ],
        "test:fixture-policy": "php scripts/check-test-fixture-policy.php",
        "test": [
            "@test:dynamic",
            "@test:seed-contracts"
        ],
        "test:coverage": [
            "@test:prepare-db",
            "phpunit --testsuite=Unit,Architecture,Integration,Feature --configuration=phpunit.xml --testdox"
        ],
        "coverage:check": "php scripts/check-coverage.php 60 tests/coverage/clover.xml",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff --sequential",
        "i18n-check": "php scripts/i18n-check.php",
        "docs-i18n-check": "php scripts/docs-i18n-parity-check.php",
        "arch-drift": [
            "@swagger-validate",
            "phpunit --testsuite=Architecture --configuration=phpunit.xml --no-coverage --testdox",
            "@i18n-check",
            "@docs-i18n-check"
        ],
        "swagger-validate": "sh -c 'php spark swagger:generate && git --no-pager diff --exit-code public/swagger.json >/dev/null || (git --no-pager diff -- public/swagger.json; exit 1)'",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@swagger-validate",
            "@arch-drift",
            "@i18n-check",
            "@docs-i18n-check",
            "@test:fixture-policy",
            "@test"
        ],
        "format": "@cs-fix",
        "format:check": "@cs-check",
        "analyse": "@phpstan"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
