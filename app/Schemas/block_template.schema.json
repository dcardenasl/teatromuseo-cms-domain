{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection Block Template",
  "description": "Defines the fixed block structure inherited by all entries of a collection",
  "type": "object",
  "required": ["version", "blocks"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Schema version for forward compatibility"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["block_key", "sort_order"],
        "additionalProperties": false,
        "properties": {
          "block_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 50,
            "description": "References cms_content_blocks.block_key"
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "description": "Human-readable label shown in admin UI"
          },
          "sort_order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Display order; must be unique within the template"
          },
          "required": {
            "type": "boolean",
            "default": true,
            "description": "Whether every entry must have this block"
          },
          "locked": {
            "type": "boolean",
            "default": false,
            "description": "Prevents editors from deleting or reordering this block"
          },
          "help_text": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional guidance shown to editors in the block form"
          },
          "block_config_defaults": {
            "type": "object",
            "description": "Initial key-value pairs written to block_config on the generated BlockInstance"
          }
        }
      }
    }
  }
}
